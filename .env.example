# Copie este archivo como .env.docker y complete los valores reales.
# No suba .env.docker al repositorio.

STACK_NAME=gestion-bomberil

# PostgreSQL
POSTGRES_DB=bomberos_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_POSTGRES

# Seguridad y nodo IoT
IOT_NODE_KEY=CAMBIAR_CLAVE_IOT
JWT_SECRET_KEY=CAMBIAR_POR_64_CARACTERES_ALEATORIOS

# Correo Gmail SMTP: use una contraseña de aplicación, no la contraseña normal.
MAIL_USERNAME=tu-correo@gmail.com
MAIL_PASSWORD=CONTRASENA_DE_APLICACION_DE_16_CARACTERES

# PayPal Sandbox
PAYPAL_CLIENT_ID=TU_CLIENT_ID_SANDBOX
PAYPAL_CLIENT_SECRET=TU_CLIENT_SECRET_SANDBOX
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# PocketBase
POCKETBASE_COLLECTION=evidencias_archivo
POCKETBASE_TOKEN=
POCKETBASE_SUPERUSER_EMAIL=admin@example.com
POCKETBASE_SUPERUSER_PASSWORD=CAMBIAR_PASSWORD_POCKETBASE

# Inteligencia artificial local
OLLAMA_MODEL=llama3.2

# ngrok: dominio reservado sin https:// y authtoken de tu cuenta
NGROK_DOMAIN=su-dominio.ngrok-free.dev
NGROK_AUTHTOKEN=TU_AUTHTOKEN_NGROK

# Puertos expuestos en el equipo anfitrión
FRONTEND_PORT=8080
FRONTEND_BASE_URL=http://localhost:8080
BACKEND_PORT=8082
POSTGRES_PORT=5433
POCKETBASE_PORT=8091
OLLAMA_PORT=11435
NGROK_INSPECT_PORT=4041
