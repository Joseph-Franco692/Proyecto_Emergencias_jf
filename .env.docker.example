# Copie este archivo como .env.docker. Nunca suba .env.docker a Git.
STACK_NAME=gestion-bomberil

POSTGRES_DB=bomberos_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_POSTGRES

IOT_NODE_KEY=CAMBIAR_CLAVE_IOT
JWT_SECRET_KEY=CAMBIAR_POR_64_CARACTERES_ALEATORIOS

MAIL_USERNAME=
MAIL_PASSWORD=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

POCKETBASE_COLLECTION=evidencias_archivo
POCKETBASE_TOKEN=

OLLAMA_MODEL=llama3.2

# Dominio reservado de ngrok, sin https://
NGROK_DOMAIN=su-dominio.ngrok-free.dev
NGROK_AUTHTOKEN=

# Puertos del host. Se usan puertos alternos para convivir con el sistema actual.
FRONTEND_PORT=8080
FRONTEND_BASE_URL=http://localhost:8080
BACKEND_PORT=8082
POSTGRES_PORT=5433
POCKETBASE_PORT=8091
OLLAMA_PORT=11435
NGROK_INSPECT_PORT=4041
